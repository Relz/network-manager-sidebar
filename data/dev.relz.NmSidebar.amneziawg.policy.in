<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "https://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Network Manager Sidebar</vendor>
  <vendor_url>https://github.com/Relz/network-manager-sidebar</vendor_url>

  <action id="dev.relz.NmSidebar.manage-amneziawg">
    <description>List and manage AmneziaWG tunnel configurations and interfaces</description>
    <message>Explicit authorization is required to list and manage AmneziaWG tunnels</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>no</allow_active>
    </defaults>
  </action>
</policyconfig>
